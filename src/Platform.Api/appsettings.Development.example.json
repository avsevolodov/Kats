{
  "ConnectionStrings": {
    "Platform": "Server=localhost,14333;Database=KatsDev;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Browser": {
    "ServerCertificate": "/absolute/path/to/.local/certs/api/server.pfx"
  },
  "Runner": {
    "ServerCertificate": "/absolute/path/to/.local/certs/api/server.pfx",
    "AllowedThumbprints": [
      "REPLACE_WITH_RUNNER_CERTIFICATE_THUMBPRINT"
    ]
  },
  "Security": {
    "PublicOrigin": "https://localhost:8443",
    "DataProtectionCertificate": "/absolute/path/to/.local/certs/api/server.pfx",
    "AdminRole": "admin"
  },
  "Git": {
    "AllowedHosts": [ "github.com", "example.invalid" ]
  },
  "Oidc": {
    "Authority": "http://localhost:8180/realms/kats-dev",
    "ClientId": "kats-local",
    "ClientSecret": "",
    "AllowLoopbackHttp": true
  }
}
